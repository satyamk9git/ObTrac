# ObTrac Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# Never commit .env to git — it's in .gitignore for safety.

# ===== Azure OpenAI (recommended) =====
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_MODEL_NAME=gpt-4o
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ===== OpenAI (optional) =====
# OPENAI_API_KEY=sk-...

# ===== Anthropic (optional) =====
# ANTHROPIC_API_KEY=sk-ant-...

# ===== Google Gemini (optional) =====
# GEMINI_API_KEY=...

# ===== Groq (optional, fast inference) =====
# GROQ_API_KEY=gsk_...

# ===== Together AI (optional) =====
# TOGETHER_API_KEY=...

# ===== ObTrac security (optional, off by default) =====
# Set this to require Authorization: Bearer <key> on every /api/* request.
# Fine to leave unset for local-only use; set it before exposing the
# backend beyond localhost or a trusted private network. See SECURITY.md.
# OBTRAC_API_KEY=

# Encrypts LLM/embedder provider API keys at rest in the database. If
# unset, a key is auto-generated on first use and stored next to the
# database file — fine for a single local instance, but set this
# explicitly (and back it up) for anything you'd need to restore from a
# backup or run as more than one instance.
# OBTRAC_ENCRYPTION_KEY=
